rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Users can read/write their own profile. Admins can read all.
    // Role can only be changed by admins (or via the Admin SDK, which bypasses rules).
    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.role == 'rider';
      allow update: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.role == resource.data.role; // can't self-promote
      allow update, delete: if isAdmin();
    }

    // Shared crew to-do list — admins only.
    match /todos/{id} {
      allow read, write: if isAdmin();
    }

    // Organiser readiness checklist — admins only.
    match /orgChecklist/{id} {
      allow read, write: if isAdmin();
    }

    // Purchases are written by the server (Admin SDK). Admins can read.
    match /purchases/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Contact enquiries are written by the server (Admin SDK). Admins can read.
    match /enquiries/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
