# From https://trello.com/power-ups/admin → your Power-Up → API key
TRELLO_API_KEY=your_api_key_here

# User token from authorize URL (NOT the OAuth "Secret"):
# https://trello.com/1/authorize?expiration=never&name=TVS%20Cursor&scope=read,write,account&response_type=token&key=YOUR_API_KEY
TRELLO_TOKEN=your_token_here

# Workspace: Dans workspace
TRELLO_WORKSPACE_ID=
TRELLO_WORKSPACE_NAME=Dans workspace

# Primary board: TVS - OW scotland
TRELLO_BOARD_ID=6acfad99aba36ddc16ab13b7
TRELLO_BOARD_URL=https://trello.com/b/YnZDCT0g/tvs-ow-scotland
TRELLO_DEFAULT_LIST_ID=
TRELLO_DEFAULT_LIST_NAME=To Do

# Lists — filled by populate_seed.py / after columns exist
TRELLO_LIST_TO_DO=
TRELLO_LIST_VENUE=
TRELLO_LIST_LEGAL_MONEY=
TRELLO_LIST_RACE=
TRELLO_LIST_WEBSITE=
TRELLO_LIST_MARKETING=
TRELLO_LIST_WAITING=

# Board member
TRELLO_MEMBER_DAN=

# Sky "Cursor" label — applied to cards created from tooling.
# Leave blank; the client creates it on the TVS board on first use.
TRELLO_LABEL_CURSOR=
